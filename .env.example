# === Database (Postgres) ===
# Local (Docker compose): postgresql+asyncpg://postgres:postgres@localhost:5432/babile_sport
# Tests:                    postgresql+asyncpg://postgres:postgres@localhost:5432/babile_sport_test
# Production (Render):      DATABASE_URL is injected automatically (render.yaml -> fromDatabase)
# Neon:                     postgresql://user:pass@host/dbname?sslmode=require
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/babile_sport

# === Redis (real-time SSE pub/sub) ===
# Local:    redis://localhost:6379/0
# Upstash:  UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN (auto-constructs rediss:// URL)
# Render:   REDIS_URL is injected from the babile-sport-redis service
REDIS_URL=redis://localhost:6379/0
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# === Auth ===
SECRET_KEY=change-me-to-a-long-random-string
# Generate a strong key with: python -c "import secrets; print(secrets.token_urlsafe(64))"
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# === Admin Seed ===
# These credentials are used to create the admin account on first startup
ADMIN_EMAIL=admin@babile.com
ADMIN_PASSWORD=Admin@123
ADMIN_DISPLAY_NAME=Admin Operator

# === App ===
PORT=8000
DEBUG=true
# Comma-separated list of allowed origins. Use "*" in development only.
CORS_ORIGINS=*
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000

# === ImageKit (image hosting) ===
# Sign up at https://imagekit.io and get these from Dashboard -> Developer -> API Keys
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key

# === Email (SMTP) — optional, for password reset emails ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Babile Sport <noreply@babilesport.com>
